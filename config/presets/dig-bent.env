# Preset: the bent dig curve, which is also the code default. It spells the curve out so it wins
# over any DIG_CURVE override in config/.env.development. Compare it with dig-plain.env.
#   npx dotenvx run -f config/presets/dig-bent.env -- npm run dev
# Rock size ∝ 2.4^(r−1) · 1.045^((r−1)²): each rock Level is a little steeper than the last.
DMD_DIG_CURVE__BASE_SECONDS=20
DMD_DIG_CURVE__ROCK_GROWTH=2.4
DMD_DIG_CURVE__ROCK_BEND=1.045
DMD_DIG_CURVE__DWARF_GROWTH=2.1
