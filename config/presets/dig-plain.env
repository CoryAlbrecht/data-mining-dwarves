# Preset: the plain exponential dig curve, to compare with the bent default (dig-bent.env).
#   npx dotenvx run -f config/presets/dig-plain.env -- npm run dev
# Rock size ∝ 3^(r−1): slower than the bent curve up to rock Level 6, quicker from Level 7 on.
DMD_DIG_CURVE__BASE_SECONDS=20
DMD_DIG_CURVE__ROCK_GROWTH=3
DMD_DIG_CURVE__ROCK_BEND=1
DMD_DIG_CURVE__DWARF_GROWTH=2.1
