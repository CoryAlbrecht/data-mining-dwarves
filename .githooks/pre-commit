#!/bin/sh
# Blocks the commit if typecheck, tests or the client build fail. Wired up by `npm install` (the prepare script).
npm run typecheck || exit 1
npm test || exit 1
# The build is long-winded: show its output only when it fails.
if ! out=$(npm run build -w @dmd/client 2>&1); then
  printf '%s\n' "$out"
  echo "pre-commit: the client build failed." >&2
  exit 1
fi
